BOT_TOKEN=replace_with_token_from_BotFather
ADMIN_IDS=123456789
MINI_APP_URL=https://your-https-domain.example
DATABASE_URL=postgresql://botuser:replace_with_password@localhost:5432/notesbot

# AI Provider (optional — can also be configured via Studio Settings UI)
# Groq (recommended for ultra-fast LPU inference):
# AI_PROVIDER=groq
# AI_PROVIDER_API_KEY=gsk_your_groq_key_here
# AI_PROVIDER_MODEL=llama-3.3-70b-versatile
#
# Google Gemini:
# AI_PROVIDER=gemini
# AI_PROVIDER_API_KEY=AIzaSy_your_gemini_key_here
# AI_PROVIDER_MODEL=gemini-3.8-flash
#
# Custom / OpenAI:
# AI_PROVIDER=custom
# AI_PROVIDER_URL=https://api.openai.com/v1/chat/completions
# AI_PROVIDER_API_KEY=sk-your-key-here
# AI_PROVIDER_MODEL=gpt-4o
